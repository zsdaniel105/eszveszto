{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eszveszto",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "ROOM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Workers Builds runs `wrangler preview` for feature branches. A local
  // class binding gets a separate Durable Object namespace per preview.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
    },
    "ratelimits": [
      {
        "name": "ROOM_LIMITER",
        "namespace_id": "1002", // Separate from production's 1001.
        "simple": { "limit": 60, "period": 60 },
      },
    ],
  },
  "observability": { "enabled": true },
}
